# Everything here is optional. Defaults are in brackets.

# Where the history database lives [~/.local/share/ai-usage-dashboard/usage.db]
# AIUSAGE_DB=/data/usage.db

# Where each tool keeps its transcripts, if you moved them
# AIUSAGE_CLAUDE_DIR=~/.claude
# AIUSAGE_CODEX_DIR=~/.codex
# AIUSAGE_OPENCODE_DIR=~/.local/share/opencode

# Seconds between rescans [120]
# AIUSAGE_SCAN_INTERVAL=120

# Address and port [127.0.0.1:4747]
# HOST=127.0.0.1
# PORT=4747
